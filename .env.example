# Copy to .env.local and fill in. .env.local is gitignored.
# Everything here is NEXT_PUBLIC_*, so it ships to the browser -- never put a
# real secret in this file.

# WalletConnect / Reown project ID, from https://dashboard.reown.com
# Without a valid value the app falls back to "demo" and Reown returns HTTP 403.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional. Defaults to https://sepolia.base.org when unset.
NEXT_PUBLIC_BASE_SEPOLIA_RPC=

# Optional. Python TEE worker. Defaults to http://localhost:8001 when unset.
NEXT_PUBLIC_TEE_URL=
